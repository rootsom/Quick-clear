{
  "manifest_version": 3,
  "name": "Quick Clear — Cache & History",
  "short_name": "Quick Clear",
  "version": "1.1.0",
  "description": "One click clears cache and browsing history. Passwords and site settings are never touched.",
  "permissions": ["browsingData"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Clear",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
